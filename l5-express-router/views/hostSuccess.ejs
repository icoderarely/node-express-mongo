<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: 'Success', cssFiles: ['success'] }) %>
  </head>
  <body>
    <%- include('partials/navigation', { currentPage: 'success' }) %>

    <!-- Main Content -->
    <main class="main">
      <div class="container">
        <!-- Hero Section -->
        <div class="success-hero">
          <h1>Success!</h1>
          <p>Your host has been successfully registered</p>
        </div>

        <!-- Success Container -->
        <div class="success-container">
          <div class="success-card celebration">
            <div class="success-icon">✅</div>
            
            <h2 class="success-title">Host Added Successfully!</h2>
            <p class="success-message">
              The host information has been saved to your system.
            </p>

            <!-- User Details -->
            <div class="user-details">
              <h3>Host Details</h3>
              <div class="detail-row">
                <span class="detail-label">🖥️ Hostname:</span>
                <span class="detail-value"><%= host.hostname %></span>
              </div>
              <div class="detail-row">
                <span class="detail-label">📅 Age:</span>
                <span class="detail-value"><%= host.age %> years</span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
              <a href="/" class="btn-action btn-primary-action">
                🏠 View All Hosts
              </a>
              <a href="/host/form" class="btn-action btn-secondary-action">
                ➕ Add Another Host
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
