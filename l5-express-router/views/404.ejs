<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: '404 - Page Not Found', cssFiles: ['404'] }) %>
  </head>
  <body>
    <%- include('partials/navigation', { currentPage: '404' }) %>

    <!-- Main Content -->
    <main class="main">
      <div class="container">
        <!-- Hero Section -->
        <div class="error-hero">
          <h1>404</h1>
          <p>Oops! This page seems to have gone missing</p>
        </div>

        <!-- Error Container -->
        <div class="error-container">
          <div class="error-card">
            <div class="error-icon floating">🔍</div>
            
            <h2 class="error-title">Page Not Found</h2>
            <p class="error-message">
              Sorry, we couldn't find the page you're looking for. 
              The page might have been moved, deleted, or you entered the wrong URL.
            </p>

            <!-- Suggestions -->
            <div class="error-suggestions">
              <h3>What you can do:</h3>
              <ul>
                <li>Check if the URL is typed correctly</li>
                <li>Go back to the home page</li>
                <li>Add a new host to get started</li>
                <li>Use the navigation menu above</li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="error-actions">
              <a href="/" class="btn-error btn-home">
                🏠 Go to Home
              </a>
              <a href="javascript:history.back()" class="btn-error btn-back">
                ↩️ Go Back
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
